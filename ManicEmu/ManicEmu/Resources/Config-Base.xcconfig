APP_BUNDLE_IDENTIFIER = com.aoshuang.manicemu
APP_BUILD_VERSION = 12
APP_VERSION = 2.0.1

// Prebuilt cores under ProjectManicEMU/Cores (Citra.framework, *.libretro.framework, …)
FRAMEWORK_SEARCH_PATHS = $(inherited) $(PROJECT_DIR)/../Cores
OTHER_LDFLAGS = $(inherited) -framework SQLCipher
